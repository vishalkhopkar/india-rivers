{
  "name": "india-rivers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:fetch": "node scripts/00-fetch-reference.mjs",
    "data:extract": "node scripts/01-extract.mjs",
    "data:tier": "node scripts/02-tier.mjs",
    "data:topology": "node --max-old-space-size=8192 scripts/03a-topology.mjs",
    "data:abroad": "node --max-old-space-size=12288 scripts/03b-abroad.mjs",
    "data:places": "node --max-old-space-size=8192 scripts/03c-places.mjs",
    "data:tiles": "node --max-old-space-size=12288 scripts/04-tiles.mjs",
    "data:all": "npm run data:fetch && npm run data:extract && npm run data:tier && npm run data:topology && npm run data:abroad && npm run data:places && npm run data:tiles",
    "verify:data": "node scripts/05-verify-tiles.mjs",
    "verify:ui": "node scripts/06-verify-pmtiles.mjs && node scripts/08-verify-interaction.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/turf": "^7.2.0",
    "fflate": "^0.8.3",
    "geojson-vt": "^5.0.4",
    "pbf": "^5.1.2",
    "proj4": "^2.22.0",
    "puppeteer-core": "^25.12.0",
    "shapefile": "^0.6.6",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vt-pbf": "^3.1.3"
  }
}
